# Required for the /admin portal
ADMIN_PASSWORD=change-me

# Used to sign the admin cookie. Generate a long random string.
ADMIN_SECRET=change-me-to-a-long-random-secret

# Required on Vercel so announcements, classes, and uploads persist.
# Create a Blob store in the Vercel dashboard and paste the token.
BLOB_READ_WRITE_TOKEN=

# Optional. Used for Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional. Free at resend.com (3,000 emails/month). If unset, first-class
# bookings still email the gym through Formsubmit — open the first mail and
# confirm the address.
RESEND_API_KEY=
